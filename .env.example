# LOCAL DEVELOPMENT ONLY — connect to your existing Windows PostgreSQL installation.
# Replace the password placeholder and URL-encode any special characters.
# Never commit a real .env file.
DATABASE_URL=postgresql://motokare:REPLACE_WITH_YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/motokare
HOST=127.0.0.1
PORT=3000
# Enable only when serving through properly configured HTTPS.
COOKIE_SECURE=0
